# PocketBase instance on brown-server (or local)
# Example: http://10.0.0.222:8091
NEXT_PUBLIC_POCKETBASE_URL=http://10.0.0.222:8091

# Collection name for the CRUD playground (create this in PocketBase admin)
NEXT_PUBLIC_POCKETBASE_COLLECTION=items

# Auth collection for email/password users (PocketBase default)
NEXT_PUBLIC_POCKETBASE_AUTH_COLLECTION=users
